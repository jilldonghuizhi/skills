# -*- coding: utf-8 -*-
"""BrowserManager：Playwright 浏览器/context 生命周期与 trace 管理（Web 共享基础设施）。

浏览器类型/无头模式只由 config.yaml 的 web.browser_types / web.headless 驱动，
不注册 pytest 选项、不依赖环境变量（避免与 pytest-playwright 插件冲突）。
web.browser_types 为列表（如 ['chromium'] 或 ['chromium','firefox']），支持多种浏览器引擎；
默认使用列表首项，可由 conftest 按参数化逐引擎运行。并行执行时每个 xdist worker 各自创建资源；teardown 必须释放。
"""
from __future__ import annotations

from pathlib import Path
from typing import Optional

from playwright.sync_api import Browser, BrowserContext, Page, sync_playwright

from utils.config_reader import ConfigReader
from utils.logger import get_logger


class BrowserManager:
    """管理 browser/context 的创建、trace 与销毁。"""

    def __init__(self, config: ConfigReader, browser_type: Optional[str] = None) -> None:
        web = config.get_section("web") or {}
        types = web.get("browser_types") or web.get("browser_type") or ["chromium"]
        if isinstance(types, str):
            types = [types]
        self.browser_types: list = types
        self.browser_type: str = browser_type or types[0]
        self.headless: bool = bool(web.get("headless", True))
        self.trace_enabled: bool = bool(web.get("trace_enabled", True))
        self.default_timeout: int = int(web.get("default_timeout", 30000))
        self.viewport: dict = {"width": 1366, "height": 768}
        self.logger = get_logger("BrowserManager")
        self._pw = None
        self.browser: Optional[Browser] = None
        self.context: Optional[BrowserContext] = None
        self.brand: str = ""
        self.version: str = ""

    def start(self) -> BrowserContext:
        """启动浏览器并新建 context（带 viewport / 超时 / trace）。"""
        self._pw = sync_playwright().start()
        launch = getattr(self._pw, self.browser_type)
        self.browser = launch(headless=self.headless)
        self.brand = self.browser.browser_type
        self.version = self.browser.version
        self.context = self.browser.new_context(
            viewport=self.viewport, ignore_https_errors=True
        )
        self.context.set_default_timeout(self.default_timeout)
        if self.trace_enabled:
            self.context.tracing.start(screenshots=True, snapshots=True, sources=True)
        self.logger.info("browser started: %s %s headless=%s", self.brand, self.version, self.headless)
        return self.context

    def new_page(self) -> Page:
        assert self.context is not None
        return self.context.new_page()

    def export_trace(self, trace_path: str) -> Optional[str]:
        """导出 trace 到 trace_path；未开启 trace 或失败返回 None。"""
        if not self.trace_enabled or self.context is None:
            return None
        try:
            Path(trace_path).parent.mkdir(parents=True, exist_ok=True)
            self.context.tracing.stop(path=trace_path)
            # 下一次使用需重新 start（worker 内通常仅一次）
            return trace_path
        except Exception as exc:  # noqa: BLE001
            self.logger.debug("导出 trace 失败: %s", exc)
            return None

    def close(self) -> None:
        """释放 context/browser/playwright。"""
        try:
            if self.context is not None:
                self.context.close()
            if self.browser is not None:
                self.browser.close()
            if self._pw is not None:
                self._pw.stop()
        except Exception as exc:  # noqa: BLE001
            self.logger.debug("关闭浏览器资源失败: %s", exc)
