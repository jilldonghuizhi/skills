name: Web UI Tests

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

jobs:
  ui-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          python -m playwright install --with-deps chromium

      - name: Run pytest
        env:
          AUTO_OPEN_REPORT: "false"
          EMAIL_ENABLED: "false"
        run: python -m pytest --alluredir=allure-results -n auto --reruns 2

      - name: Upload Allure results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: allure-results
          path: allure-results/

      - name: Upload report json
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: report-json
          path: report.json
